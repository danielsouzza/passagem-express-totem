# Normaliza tudo pra LF no repo, independente de quem está commitando.
# Resolve o warning "LF will be replaced by CRLF" no Windows.
* text=auto eol=lf

# Código-fonte: força LF
*.kt    text eol=lf
*.kts   text eol=lf
*.java  text eol=lf
*.xml   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.properties text eol=lf
*.pro   text eol=lf

# Scripts Windows precisam continuar com CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# gradlew (shell) é LF; gradlew.bat (Windows) é CRLF
gradlew     text eol=lf
gradlew.bat text eol=crlf

# Binários: não tocar
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.svg   text eol=lf
*.pdf   binary
*.jar   binary
*.apk   binary
*.aab   binary
*.aar   binary
*.keystore binary
*.jks   binary
*.so    binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
